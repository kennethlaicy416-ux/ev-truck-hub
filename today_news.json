import os
import json
from datetime import datetime
import google.generativeai as genai

# 1. 初始化 Gemini API
API_KEY = os.environ.get("GEMINI_API_KEY")
genai.configure(api_key=API_KEY)

# 2. 使用支援聯網與結構化輸出的模型
model = genai.GenerativeModel(
    'gemini-2.5-flash',
    generation_config={
        "response_mime_type": "application/json",
        "temperature": 0.7
    }
)

def fetch_and_analyze_news():
    today_str = datetime.now().strftime("%Y-%m-%d")
    
    # 提示詞直接結合搜尋與分析要求
    prompt = f"""
    你是一位資深的中國新能源純電重卡（Heavy EV Truck）市場與銷售情報分析師。
    請即時搜尋並掌握當前中國市場（如三一重工、徐工、解放、重汽、寧德時代等企業）在新能源重卡、換電重卡、電池補能、路權政策及大宗招投標方麵的最新動態。
    請挑選出 4 到 6 條最具商業與銷售價值的核心情報，並嚴格以 JSON Array 格式輸出，每個物件包含以下欄位：
    - "id": 唯一數字編號 (1, 2, 3...)
    - "category": 必須是 ["policy", "competitor", "battery", "bidding"] 之一
    - "tag": 對應的中文標籤 ["🏛️ 政策路权", "🎯 竞品动态", "🔋 电池与补能", "💰 招投标线索"] 之一
    - "title": 簡潔有力的情報標題（簡體中文，25字以內）
    - "date": "{today_str}"
    - "summary": 核心內容摘要與關鍵數據（簡體中文，50-80字）
    - "action": 針對我們銷售與大客戶團隊的應對建議（簡體中文，30-50字）
    """
    
    try:
        print("正在呼叫 Gemini 進行聯網情報搜集與分析...")
        # 讓 AI 聯網並生成結果
        response = model.generate_content(prompt)
        structured_data = json.loads(response.text)
        return structured_data
    except Exception as e:
        print(f"聯網分析失敗: {e}")
        return []

if __name__ == "__main__":
    news_data = fetch_and_analyze_news()
    if news_data:
        with open("today_news.json", "w", encoding="utf-8") as f:
            json.dump(news_data, f, ensure_ascii=False, indent=2)
        print("✅ 成功更新 today_news.json！")
    else:
        print("⚠️ 未能生成有效數據。")
